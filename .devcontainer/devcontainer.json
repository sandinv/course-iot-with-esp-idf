{
    "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
    "name": "ESP-IDF Development Environment",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "IDF_VERSION": "5.4.1",
            "IDF_TARGETS": "esp32",
            "INSTALL_MOSQUITTO": "false"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "ms-vscode.hexeditor"
            ]
        }
    },
    "mounts": [
        "source=${localWorkspaceFolder}/apps,target=/workspace/apps,type=bind,consistency=cached"
    ],
    "workspaceFolder": "/workspace",
    "runArgs": [
        "--network=bridge"
    ],
    "remoteUser": "root"
}
